# Bevins web app configuration. Copy to .env (never commit it) or to /etc/bevins/bevins.env.
# Every secret can instead be supplied as a file in $CREDENTIALS_DIRECTORY (systemd LoadCredential);
# credential names are given in brackets.

# PostgreSQL connection (app role must NOT have BYPASSRLS)
DATABASE_URL=postgresql://bevins:CHANGE_ME@127.0.0.1:5432/bevins
PORT=8099

# One-time token required to create the first (admin) account   [bootstrap]
ADMIN_BOOTSTRAP_TOKEN=

# Shared secret between the mail poller and /api/scan-email      [scan_secret]
SCAN_SECRET=
# Server-side LLM provider key used for forwarded-mail scans     [server_llm]
SERVER_LLM_KEY=
# Optional owner-funded OpenRouter key                           [server_or]
SERVER_OR_KEY=
# Comma-separated emails allowed to use the funded key (empty = nobody)
FUNDED_USERS=
FUNDED_MAX_PRICE_OUT=8.0
FUNDED_DAILY_TOKEN_CAP=

# Optional threat-intel / grounding providers
TAVILY_API_KEY=                 # [tavily]
VT_API_KEY=                     # [virustotal]
SAFEBROWSING_API_KEY=           # [safebrowsing]

# Optional overrides
BEVINS_SCAM_MODEL=
BEVINS_AUDIT_DIR=
CREDENTIALS_DIRECTORY=
