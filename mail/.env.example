# Bevins forwarding-mailbox services (bevins_mail.py SMTP receiver / bevins_mailpoll.py IMAP poller).
# Never commit real values. Prefer systemd credentials for secrets.
APP_URL=http://127.0.0.1:8099
SCAN_SECRET=
MAIL_ADDR=scam@bevins.example.com
MAIL_DOMAIN=bevins.example.com

# SMTP receiver (bevins_mail.py)
LISTEN_HOST=127.0.0.1
LISTEN_PORT=2525
DKIM_SELECTOR=bevins
DKIM_KEY_PATH=/etc/bevins/creds/dkim_private.pem
MAX_MSG_BYTES=
DEBUG_SINK_DIR=

# IMAP poller (bevins_mailpoll.py)
IMAP_HOST=imap.example.com
IMAP_PORT=993
SMTP_HOST=smtp.example.com
SMTP_PORT=587
MAILBOX=INBOX
MAILBOX_USER=scam@bevins.example.com
MAILBOX_PASS=
MAIL_STATE_PATH=/var/lib/bevins-mailpoll/state.sqlite3
POLL_SECONDS=60
# Approved reply destinations (comma-separated). Empty refuses activation.
MAIL_REPLY_ALLOWLIST=
